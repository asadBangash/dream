APP_NAME="The Dream Tuition Academy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_DOMAIN=dream.test
APP_URL=http://dream.test
APP_MAIN_APP_URL=dream.test
APP_API_URL="${APP_URL}/api/public/v1"
APP_HTTPS=false
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
APP_DIR=ltl
APP_CACHE_TIME=100
LARAVEL_PAGE_SPEED_ENABLE=true
APP_SAAS=false
APP_TRANSLATE=false
APP_PDO=false
# Set true for full multi-branch demo data (Boys/Girls branches, DreamTuitionDemoSeeder)
APP_DEMO=false
APP_VER="2.0"

QUEUE_CONNECTION=database

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dream
DB_USERNAME=root
DB_PASSWORD=

CACHE_DRIVER=array

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=predis

BROADCAST_DRIVER=log
FILESYSTEM_DRIVER=local
FILESYSTEM_DISK=local
STORAGE_DIRECT_PUBLIC=false
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

JWT_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

NOCAPTCHA_SECRET=
NOCAPTCHA_SITEKEY=

GOOGLE_MAP_KEY=

FIREBASE_CREDENTIALS="firebase_credentials.json"
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_COLLECTION=

STRIPE_KEY=
STRIPE_SECRET=
